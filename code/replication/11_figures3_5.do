/**********************/
/*Clean and set memory*/
/**********************/
clear all
set matsize 11000
set more off

/*********************/
/*Sets base directory*/
/*********************/
if "${project}" == "" global project "`c(pwd)'"
cd "$project"
cap mkdir "${project}/results"

/* NOTE: Figures 3-5 require the following files to already exist in
   ${project}/results/, generated by your Table 5 (semiparametric) do-file:
     - impulse_ra_alt.dta
     - impulse_ipw_alt.dta
     - impulse_ipwra_alt.dta
   Run the Table 5 do-file first if these are missing.            */

/**********************************************************************
* FIGURE 3: Regression Adjustment (RA) semiparametric estimates
**********************************************************************/
use "${project}/results/impulse_ra_alt", clear

split parm, p("c")
keep if parm2 != ""
destring parm2, force replace
gen time = parm2 - 16       /* maps column index to years -15 ... +30 */
tsset time

twoway ///
    (tsline estimate, lcolor(black) lpattern(solid)) ///
    (tsline min95,    lcolor(gray)  lpattern(dash))  ///
    (tsline max95,    lcolor(gray)  lpattern(dash))  ///
    , ///
    ytitle("Change in GDP per capita log points") ///
    xtitle("Years around democratization") ///
    legend(off) ///
    xlabel(-15(5)30) ylabel(-20(10)45) ///
    graphregion(fcolor(white) lcolor(white) ifcolor(white) ilcolor(white)) ///
    plotregion(fcolor(white) lcolor(white) ifcolor(white) ilcolor(white))

/* FIX: .png instead of .eps (Stata 19 .eps preview unreliable on Mac)
   For .eps: graph export "${project}/results/ImpVarRA.eps", as(eps) preview(off) replace */
graph export "${project}/results/ImpVarRA.png", as(png) replace
di "Figure 3 saved to ${project}/results/ImpVarRA.png"

